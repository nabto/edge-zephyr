mainmenu "Nabto Edge Thermostat Demo"

config THERMOSTAT_PRODUCT_ID
	string "nabto product id"
	default "pr-123"
	help
	  The nabto product id to use

config THERMOSTAT_DEVICE_ID
	string "nabto device id"
	default "de-123"
	help
	  The nabto device id to use

config THERMOSTAT_PRIVATE_KEY
    string "nabto device key"
	default ""
	help
	  The nabto device key as a hex encoded 256bit random number

source "Kconfig.zephyr"
